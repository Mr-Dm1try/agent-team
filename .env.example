# Copy to .env and fill in. agent-team reads .env from the folder you run it in;
# a variable already set in your shell wins over this file.

# Required for the Claude models.
ANTHROPIC_API_KEY=

# Optional: a config file other than config/default.yaml. Ollama's address, models
# and embedder are set there (providers.ollama, memory.embedder).
# AGENT_TEAM_CONFIG=config/default.yaml
